@startuml
title Flujo comercial de búsqueda y cotización

skinparam shadowing false

start

:Usuario ingresa al sitio;
:Ve home con buscador global;

if (Busca directamente?) then (sí)
  :Escribe texto en buscador global;
else (no)
  :Explora líneas o TW Store;
endif

:Carga catálogo global JSON;
:Filtra por línea de negocio;
:Filtra por categoría;
:Filtra por precio o condición de cotización;
:Filtra por moneda;
:Ordena resultados;

if (Entra a sección específica?) then (sí)
  :Abre página de línea;
  :Búsqueda limitada a esa línea;
else (no)
  :Permanece en TW Store o Home;
endif

:Ve productos, servicios, cursos o proyectos;
:Revisa precio público, estado y descripción;

if (Desea comprar o consultar?) then (sí)
  :Pulsa Cotizar por WhatsApp;
  :Se envía mensaje prellenado;
  :Tecprog confirma disponibilidad;
  :Tecprog confirma precio;
  :Tecprog confirma garantía;
  :Tecprog confirma envío o alcance;
else (no)
  :Sigue explorando catálogo;
endif

stop

@enduml

